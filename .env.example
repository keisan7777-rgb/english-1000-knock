# Instagram Login方式（Facebookページ連携なし）
INSTAGRAM_ACCESS_TOKEN=ここにアクセストークン
INSTAGRAM_USER_ID=ここにInstagramプロアカウントID

# Meta公式ドキュメントで現在確認できる既定値。変更時はここだけ更新します。
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com

# Metaが4枚の画像を取得できる公開HTTPS URL
# 末尾に /generated は付けません。
PUBLIC_MEDIA_BASE_URL=https://keisan7777-rgb.github.io/english-1000-knock

